# ==============================================================================
# AquaGuard Portal - Environment Configuration Template
# ==============================================================================

# Ollama LLM Connection Settings
OLLAMA_HOST=http://localhost:11434
# Gemma 4 e4b is recommended for edge Pi 5 (16GB) - pins to specific multimodal tag
OLLAMA_MODEL=gemma4:e4b

# MQTT Broker Settings
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=aquaguard/sensors
MQTT_USERNAME=
MQTT_PASSWORD=

# Sovereign Storage Paths & Lifecycle Control
MEDIA_DIR=./telemetry_data/media
SENSOR_LOGS_DIR=./telemetry_data/sensor_logs
COMPLIANCE_DIR=./telemetry_data/compliance
MEDIA_RETENTION_HOURS=48
CRITICAL_DISK_USAGE_PCT=85.0

# Camera/Video Frame settings
CAMERA_DEVICE_INDEX=0
CAMERA_FPS=30

# Audio/Hydrophone recording settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=4096

# Actuation & GPIO configurations
HARDWARE_AERATOR_GPIO_PIN=17
HARDWARE_PUMP_GPIO_PIN=27
HARDWARE_VALVE_GPIO_PIN=22
HARDWARE_ALERT_GPIO_PIN=23
HARDWARE_ENABLE_CONTROL=false

# Regulatory Consent Settings
# Example values: "Horizons Regional Council", "Waikato Regional Council", "Environment Canterbury"
REGIONAL_COUNCIL=Horizons Regional Council
CONSENT_ID=CONSENT-2026-AUTH-0981

# Operational Water Quality Thresholds
THRESHOLD_PH_MIN=6.5
THRESHOLD_PH_MAX=8.5
# Dissolved Oxygen in mg/L - minimum threshold for fish health
THRESHOLD_DO_MIN=5.0
# Temperature in Celsius
THRESHOLD_TEMP_MAX=24.0
# Turbidity in NTU (Nephelometric Turbidity Units)
THRESHOLD_TURBIDITY_MAX=50.0
# Nitrate in mg/L
THRESHOLD_NITRATE_MAX=10.0

# System Log Configuration
LOG_LEVEL=INFO
LOG_FILE=./telemetry_data/aquaguard.log

# ==============================================================================
# AQUAGUARD PORTAL SECOPS CONFIGURATION
# ==============================================================================

# Access Control
PORTAL_SESSION_SECRET=generate_a_cryptographic_random_string_here
ALLOWED_CORS_ORIGINS=https://localhost,https://192.168.1.100

# Rate Limiting (Prevent Brute Force)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# HTTP Server Configuration
PORT=3000
AQUAGUARD_NONCE_TTL_MS=120000
AQUAGUARD_DB_PATH=./data/aquaguard_attestation.db

# Edge Network Routing
WEAVER_EDGE_URL=ssl://your-weaver-node-ip:8883

# GitHub Packages Authentication
# Generate a classic PAT token with 'read:packages' permissions and insert it in your real .env
GITHUB_TOKEN=your_github_personal_access_token_here


